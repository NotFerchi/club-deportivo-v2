# ===========================
# Servidor
# ===========================
PORT=3000
NODE_ENV=development

# ===========================
# Base de datos Neon (PostgreSQL)
# ===========================
DATABASE_URL=postgresql://usuario:password@host-pooler.region.aws.neon.tech/nombredb?sslmode=require

# ===========================
# Seguridad
# ===========================
JWT_SECRET=cambia_este_valor_por_un_secreto_largo
QR_SECRET=cambia_este_valor_por_un_secreto_largo_y_aleatorio_de_al_menos_32_bytes

# ===========================
# CORS — URL del frontend en desarrollo local
# ===========================
CORS_ORIGIN=http://localhost:3001

# ===========================
# Envío de correos (QR de visitas por Gmail)
# ===========================
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=tu_app_password_de_gmail

# ===========================
# Reglas de negocio del club
# Los valores mostrados son los defaults reales que usa el código
# si la variable no está definida
# ===========================
CLUB_HORA_CIERRE=22:00
RESERVAS_DURACION_MINUTOS=60
RESERVAS_MAX_ACTIVAS_SOCIO=2
RESERVAS_MISMO_DIA=true
RESERVAS_PERMITIR_PASADAS=false