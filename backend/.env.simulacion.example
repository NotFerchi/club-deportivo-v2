# Plantilla de backend/.env.simulacion (U5-07). Copia este archivo como .env.simulacion y llénalo ahí:
# .env.simulacion está ignorado por git y nunca se sube. Ver docs/simulacion/README.md.

# URL del branch de Neon "simulacion-u5" (solo esquema). Nunca la de production.
SIMULACION_DATABASE_URL=

# Contraseñas de las cuentas de acceso de la simulación (las define U5-08).
# Las que queden vacías se reportan como pendientes; la semilla nunca las imprime.
SIM_PASS_ADMIN=
SIM_PASS_GERENTE=
SIM_PASS_COORDINADOR=
SIM_PASS_RECEPCION=
SIM_PASS_INSTRUCTOR=
SIM_PASS_SOCIO=
