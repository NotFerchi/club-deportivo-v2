exports[`POST /lectura-qr: socio entrada y luego salida (timestamp Date → ISO) 1`] = `
[
  [
    "client",
    "BEGIN",
    [],
  ],
  [
    "client",
    "SELECT q.qr_id, s.socio_id, s.activo, COALESCE( NULLIF(TRIM(CONCAT(u.nombres, ' ', u.apellido_paterno, ' ', COALESCE(u.apellido_materno, ''))), ''), s.numero_socio, CONCAT('Socio ', s.socio_id) ) AS nombre_completo FROM codigos_qr_socios q JOIN socios s ON s.socio_id = q.socio_id LEFT JOIN usuarios u ON u.usuario_id = s.usuario_id WHERE q.codigo_qr = ANY($1::text[]) AND q.activo = TRUE ORDER BY q.created_at DESC, q.qr_id DESC LIMIT 1 FOR UPDATE OF q, s",
    [
      [
        "{"a":1}",
        "data:image/png;base64,QR({"a":1})",
      ],
    ],
  ],
  [
    "client",
    "SELECT tipo FROM registro_acceso WHERE ($1::int IS NOT NULL AND socio_id = $1) OR ($2::int IS NOT NULL AND visita_id = $2) OR ($3::int IS NOT NULL AND pase_id = $3) ORDER BY "timestamp" DESC, acceso_id DESC LIMIT 1",
    [
      10,
      null,
      null,
    ],
  ],
  [
    "client",
    "INSERT INTO registro_acceso ( socio_id, visita_id, tipo, metodo, "timestamp" ) VALUES ($1, $2, $3, $4, NOW()) RETURNING acceso_id, "timestamp"",
    [
      10,
      null,
      "entrada",
      "qr",
    ],
  ],
  [
    "client",
    "COMMIT",
    [],
  ],
  [
    "client",
    "BEGIN",
    [],
  ],
  [
    "client",
    "SELECT q.qr_id, s.socio_id, s.activo, COALESCE( NULLIF(TRIM(CONCAT(u.nombres, ' ', u.apellido_paterno, ' ', COALESCE(u.apellido_materno, ''))), ''), s.numero_socio, CONCAT('Socio ', s.socio_id) ) AS nombre_completo FROM codigos_qr_socios q JOIN socios s ON s.socio_id = q.socio_id LEFT JOIN usuarios u ON u.usuario_id = s.usuario_id WHERE q.codigo_qr = ANY($1::text[]) AND q.activo = TRUE ORDER BY q.created_at DESC, q.qr_id DESC LIMIT 1 FOR UPDATE OF q, s",
    [
      [
        "x",
        "data:image/png;base64,QR(x)",
      ],
    ],
  ],
  [
    "client",
    "SELECT tipo FROM registro_acceso WHERE ($1::int IS NOT NULL AND socio_id = $1) OR ($2::int IS NOT NULL AND visita_id = $2) OR ($3::int IS NOT NULL AND pase_id = $3) ORDER BY "timestamp" DESC, acceso_id DESC LIMIT 1",
    [
      10,
      null,
      null,
    ],
  ],
  [
    "client",
    "INSERT INTO registro_acceso ( socio_id, visita_id, tipo, metodo, "timestamp" ) VALUES ($1, $2, $3, $4, NOW()) RETURNING acceso_id, "timestamp"",
    [
      10,
      null,
      "salida",
      "qr",
    ],
  ],
  [
    "client",
    "COMMIT",
    [],
  ],
]
`;

