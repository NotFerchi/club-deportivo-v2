exports[`GET /metricas tipo=socio 2`] = `
[
  [
    "pool",
    "SELECT COUNT(*) AS total_accesos, COUNT(*) FILTER (WHERE tipo = 'entrada') AS total_entradas, COUNT(*) FILTER (WHERE tipo = 'salida') AS total_salidas FROM registro_acceso WHERE "timestamp" >= $1::date AND "timestamp" < ($2::date + INTERVAL '1 day') AND socio_id IS NOT NULL",
    [
      "2026-09-01",
      "2026-09-03",
    ],
  ],
  [
    "pool",
    "SELECT EXTRACT(HOUR FROM "timestamp")::int AS hora, COUNT(*)::int AS total FROM registro_acceso WHERE "timestamp" >= $1::date AND "timestamp" < ($2::date + INTERVAL '1 day') AND socio_id IS NOT NULL GROUP BY hora ORDER BY total DESC",
    [
      "2026-09-01",
      "2026-09-03",
    ],
  ],
  [
    "pool",
    "SELECT DATE("timestamp") AS fecha, COUNT(*)::int AS total FROM registro_acceso WHERE "timestamp" >= $1::date AND "timestamp" < ($2::date + INTERVAL '1 day') AND socio_id IS NOT NULL GROUP BY fecha ORDER BY fecha ASC",
    [
      "2026-09-01",
      "2026-09-03",
    ],
  ],
  [
    "pool",
    "SELECT ra.socio_id, COALESCE( NULLIF(TRIM(CONCAT(u.nombres, ' ', u.apellido_paterno, ' ', COALESCE(u.apellido_materno, ''))), ''), CONCAT('Socio ', ra.socio_id) ) AS nombre, COUNT(*)::int AS total_accesos FROM registro_acceso ra LEFT JOIN socios s ON s.socio_id = ra.socio_id LEFT JOIN usuarios u ON u.usuario_id = s.usuario_id WHERE ra."timestamp" >= $1::date AND ra."timestamp" < ($2::date + INTERVAL '1 day') AND ra.socio_id IS NOT NULL AND ra.socio_id IS NOT NULL GROUP BY ra.socio_id, u.nombres, u.apellido_paterno, u.apellido_materno ORDER BY total_accesos DESC LIMIT 10",
    [
      "2026-09-01",
      "2026-09-03",
    ],
  ],
]
`;

