exports[`PATCH /api/encuentros/:id/resultado edición con cambio de ganador → reemplaza al ganador anterior en el slot de la regla (B-05) 1`] = `
{
  "encuentro": {
    "cancha_asignada": null,
    "encuentro_id": 100,
    "estado": "finalizado",
    "ganador_id": 12,
    "marcador_1": 1,
    "marcador_2": 4,
    "ronda": 1,
  },
  "ganador_id": 12,
  "message": "Resultado actualizado correctamente",
  "ok": true,
  "siguiente_encuentro": {
    "campo": "participante_1_id",
    "encuentro_id": 201,
    "ganador": 12,
    "ronda": 2,
  },
}
`;

exports[`PATCH /api/encuentros/:id/resultado edición con cambio de ganador → reemplaza al ganador anterior en el slot de la regla (B-05) 2`] = `
[
  [
    "client",
    "BEGIN",
    [],
  ],
  [
    "client",
    "SELECT t.estado FROM encuentros_torneo e JOIN torneos t ON t.torneo_id = e.torneo_id WHERE e.encuentro_id = $1 AND t.activo FOR SHARE OF t",
    [
      100,
    ],
  ],
  [
    "client",
    "SELECT encuentro_id, torneo_id, ronda, estado, participante_1_id, participante_2_id, ganador_id FROM encuentros_torneo WHERE encuentro_id = $1 FOR UPDATE",
    [
      100,
    ],
  ],
  [
    "client",
    "SELECT COUNT(*) FILTER (WHERE encuentro_id < $3)::int AS posicion, COUNT(*)::int AS total FROM encuentros_torneo WHERE torneo_id = $1 AND ronda = $2",
    [
      4,
      1,
      100,
    ],
  ],
  [
    "client",
    "SELECT encuentro_id, ronda, estado, participante_1_id, participante_2_id FROM encuentros_torneo WHERE torneo_id = $1 AND ronda = $2 ORDER BY encuentro_id OFFSET $3 LIMIT 1 FOR UPDATE",
    [
      4,
      2,
      0,
    ],
  ],
  [
    "client",
    "UPDATE encuentros_torneo SET marcador_1 = $1, marcador_2 = $2, ganador_id = $3, estado = 'finalizado', cancha_asignada = COALESCE($5, cancha_asignada) WHERE encuentro_id = $4 RETURNING encuentro_id, ronda, marcador_1, marcador_2, ganador_id, estado, cancha_asignada",
    [
      1,
      4,
      12,
      100,
      null,
    ],
  ],
  [
    "client",
    "UPDATE encuentros_torneo SET participante_1_id = $1 WHERE encuentro_id = $2 RETURNING encuentro_id, ronda, participante_1_id, participante_2_id",
    [
      12,
      201,
    ],
  ],
  [
    "client",
    "SELECT COUNT(*) as total FROM encuentros_torneo WHERE torneo_id = $1 AND ronda = $2 AND estado != 'finalizado'",
    [
      4,
      1,
    ],
  ],
  [
    "client",
    "UPDATE encuentros_torneo SET estado = 'programado' WHERE torneo_id = $1 AND ronda = $2 AND estado = 'pendiente'",
    [
      4,
      2,
    ],
  ],
  [
    "client",
    "COMMIT",
    [],
  ],
]
`;

