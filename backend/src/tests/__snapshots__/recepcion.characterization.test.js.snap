exports[`GET /visitas con tabla pases 1`] = `
[
  [
    "pool",
    "UPDATE pases SET hora_salida = (NOW() AT TIME ZONE 'America/Mexico_City'), estado = 'finalizado' WHERE estado = 'activo' AND ( fecha_pase < ((NOW() AT TIME ZONE 'America/Mexico_City'))::date OR (fecha_pase = ((NOW() AT TIME ZONE 'America/Mexico_City'))::date AND ((NOW() AT TIME ZONE 'America/Mexico_City'))::time >= $1::time) ) RETURNING pase_id",
    [
      "22:00",
    ],
  ],
  [
    "pool",
    "SELECT p.pase_id, p.pase_id as visita_id, p.tipo_pase, p.socio_id, p.socio_id as socio_anfitrion_id, p.nombre_completo, split_part(p.nombre_completo, ' ', 1) as nombre, NULLIF(BTRIM(SUBSTRING(p.nombre_completo FROM LENGTH(split_part(p.nombre_completo, ' ', 1)) + 1)), '') as apellidos, p.correo, p.telefono, p.mayor_16, p.identificacion, p.fecha_pase, p.fecha_pase as fecha_visita, p.hora_entrada, p.hora_salida, p.estado, (p.estado = 'activo') as vigente, p.observaciones, p.observaciones as motivo, NULL::text as identificacion, NULL::text as identificacion_tipo, s.numero_socio, NULLIF(TRIM(CONCAT(u.nombres, ' ', u.apellido_paterno, ' ', COALESCE(u.apellido_materno, ''))), '') as socio_nombre, u.nombres as socio_anfitrion_nombre, u.apellido_paterno as socio_anfitrion_apellido, u.apellido_materno as socio_anfitrion_apellido_materno, u.username as socio_anfitrion_email FROM pases p LEFT JOIN socios s ON p.socio_id = s.socio_id LEFT JOIN usuarios u ON s.usuario_id = u.usuario_id WHERE p.fecha_pase = $1 ORDER BY p.hora_entrada DESC",
    [
      "2026-09-30",
    ],
  ],
]
`;

exports[`GET /visitas sin tabla pases → visitas (sin columnas opcionales) 1`] = `
[
  [
    "pool",
    "UPDATE pases SET hora_salida = (NOW() AT TIME ZONE 'America/Mexico_City'), estado = 'finalizado' WHERE estado = 'activo' AND ( fecha_pase < ((NOW() AT TIME ZONE 'America/Mexico_City'))::date OR (fecha_pase = ((NOW() AT TIME ZONE 'America/Mexico_City'))::date AND ((NOW() AT TIME ZONE 'America/Mexico_City'))::time >= $1::time) ) RETURNING pase_id",
    [
      "22:00",
    ],
  ],
  [
    "pool",
    "UPDATE visitas SET hora_salida = (NOW() AT TIME ZONE 'America/Mexico_City'), vigente = false WHERE vigente = true AND ( fecha_visita < ((NOW() AT TIME ZONE 'America/Mexico_City'))::date OR (fecha_visita = ((NOW() AT TIME ZONE 'America/Mexico_City'))::date AND ((NOW() AT TIME ZONE 'America/Mexico_City'))::time >= $1::time) ) RETURNING visita_id",
    [
      "22:00",
    ],
  ],
  [
    "pool",
    "SELECT p.pase_id, p.pase_id as visita_id, p.tipo_pase, p.socio_id, p.socio_id as socio_anfitrion_id, p.nombre_completo, split_part(p.nombre_completo, ' ', 1) as nombre, NULLIF(BTRIM(SUBSTRING(p.nombre_completo FROM LENGTH(split_part(p.nombre_completo, ' ', 1)) + 1)), '') as apellidos, p.correo, p.telefono, p.mayor_16, p.identificacion, p.fecha_pase, p.fecha_pase as fecha_visita, p.hora_entrada, p.hora_salida, p.estado, (p.estado = 'activo') as vigente, p.observaciones, p.observaciones as motivo, NULL::text as identificacion, NULL::text as identificacion_tipo, s.numero_socio, NULLIF(TRIM(CONCAT(u.nombres, ' ', u.apellido_paterno, ' ', COALESCE(u.apellido_materno, ''))), '') as socio_nombre, u.nombres as socio_anfitrion_nombre, u.apellido_paterno as socio_anfitrion_apellido, u.apellido_materno as socio_anfitrion_apellido_materno, u.username as socio_anfitrion_email FROM pases p LEFT JOIN socios s ON p.socio_id = s.socio_id LEFT JOIN usuarios u ON s.usuario_id = u.usuario_id WHERE p.fecha_pase = $1 ORDER BY p.hora_entrada DESC",
    [
      "2026-09-30",
    ],
  ],
  [
    "pool",
    "SELECT column_name FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = 'visitas' AND column_name = ANY($1::text[])",
    [
      [
        "socio_id",
        "correo",
        "telefono",
        "mayor_16",
        "observaciones",
      ],
    ],
  ],
  [
    "pool",
    "SELECT v.visita_id, v.visita_id as pase_id, CASE WHEN false THEN 'visita' WHEN LOWER(COALESCE(v.identificacion_tipo, '')) IN ('dia', 'pase dia', 'pase de dia', 'pase de un dia') THEN 'dia' ELSE 'visita' END as tipo_pase, NULL::int as socio_id, NULL::int as socio_anfitrion_id, v.nombre_completo, split_part(v.nombre_completo, ' ', 1) as nombre, NULLIF(BTRIM(SUBSTRING(v.nombre_completo FROM LENGTH(split_part(v.nombre_completo, ' ', 1)) + 1)), '') as apellidos, NULL::text as correo, NULL::text as telefono, true as mayor_16, v.fecha_visita as fecha_pase, v.fecha_visita, v.hora_entrada, v.hora_salida, CASE WHEN v.vigente THEN 'activo' ELSE 'finalizado' END as estado, v.vigente, NULL::text as observaciones, NULL::text as motivo, v.identificacion_tipo as identificacion, v.identificacion_tipo, NULL::text as numero_socio, NULL::text as socio_nombre, NULL::text as socio_anfitrion_nombre, NULL::text as socio_anfitrion_apellido, NULL::text as socio_anfitrion_apellido_materno, NULL::text as socio_anfitrion_email FROM visitas v WHERE v.fecha_visita = $1 ORDER BY v.hora_entrada DESC",
    [
      "2026-09-30",
    ],
  ],
]
`;

