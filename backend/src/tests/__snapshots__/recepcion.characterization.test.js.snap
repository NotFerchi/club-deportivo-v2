exports[`GET /dashboard con tabla pases y cierre automático auditado 2`] = `
[
  [
    "pool",
    "UPDATE pases SET hora_salida = (NOW() AT TIME ZONE 'America/Mexico_City'), estado = 'finalizado' WHERE estado = 'activo' AND ( fecha_pase < ((NOW() AT TIME ZONE 'America/Mexico_City'))::date OR (fecha_pase = ((NOW() AT TIME ZONE 'America/Mexico_City'))::date AND ((NOW() AT TIME ZONE 'America/Mexico_City'))::time >= $1::time) ) RETURNING pase_id",
    [
      "22:00",
    ],
  ],
  [
    "pool",
    "SELECT COUNT(*) FROM asistencia WHERE fecha = $1",
    [
      "2026-09-30",
    ],
  ],
  [
    "pool",
    "SELECT COUNT(*) FROM registro_ludoteca WHERE hora_salida IS NULL",
    [],
  ],
  [
    "pool",
    "SELECT COUNT(*) FROM sanciones WHERE LOWER(estado::text) IN ('activo', 'activa')",
    [],
  ],
  [
    "pool",
    "SELECT COUNT(DISTINCT a.socio_id)::int as total, COUNT(DISTINCT a.socio_id) FILTER (WHERE LOWER(COALESCE(s.tipo::text, s.modalidad::text, '')) = 'accionista')::int as accionistas, COUNT(DISTINCT a.socio_id) FILTER (WHERE LOWER(COALESCE(s.tipo::text, s.modalidad::text, '')) <> 'accionista')::int as rentistas FROM asistencia a JOIN socios s ON a.socio_id = s.socio_id WHERE a.fecha = $1 AND a.presente = true AND a.socio_id IS NOT NULL",
    [
      "2026-09-30",
    ],
  ],
  [
    "pool",
    "SELECT COUNT(*)::int as total, COUNT(*) FILTER (WHERE LOWER(estado::text) IN ('confirmada', 'confirmado', 'pendiente'))::int as activas, COUNT(*) FILTER (WHERE LOWER(estado::text) IN ('cancelada', 'cancelado'))::int as canceladas, COUNT(*) FILTER (WHERE COALESCE(no_show, false) = true OR LOWER(estado::text) IN ('no-show', 'no show'))::int as no_shows FROM reservaciones WHERE fecha_reserva = $1",
    [
      "2026-09-30",
    ],
  ],
  [
    "pool",
    "SELECT COUNT(*)::int as total, COUNT(*) FILTER (WHERE tipo_pase = 'dia')::int as pases_dia, COUNT(*) FILTER (WHERE tipo_pase = 'visita')::int as visitas FROM pases WHERE estado = 'activo' AND fecha_pase = $1",
    [
      "2026-09-30",
    ],
  ],
]
`;

