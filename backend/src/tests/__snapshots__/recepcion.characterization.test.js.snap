    [
      "2026-09-30",
    ],
  ],
]
`;

exports[`GET /visitas/:id/qr pase activo → QR; inactivo → 400 1`] = `
{
  "expira_en": "2026-10-01T18:00:00.000Z",
  "ok": true,
  "qr_image": "data:image/png;base64,QR({"type":"pase","pase_id":1,"expira_en":"2026-10-01T18:00:00.000Z","hash":"hmac({\\"type\\":\\"pase\\",\\"pase_id\\":1,\\"expira_en\\":\\"2026-10-01T18:00:00.000Z\\"})"})",
}
`;

exports[`GET /visitas/:id/qr pase activo → QR; inactivo → 400 2`] = `
[
  [
    "client",
    "BEGIN",
    [],
  ],
  [
    "client",
    "SELECT pase_id, estado FROM pases WHERE pase_id = $1",
    [
      "1",
    ],
  ],
  [
    "client",
    "SAVEPOINT before_qr_pase",
    [],
  ],
  [
    "client",
    "INSERT INTO codigos_qr_pases (pase_id, codigo_qr, expira_en, activo) VALUES ($1, $2, $3, TRUE) ON CONFLICT (pase_id) DO UPDATE SET codigo_qr = EXCLUDED.codigo_qr, expira_en = EXCLUDED.expira_en, activo = TRUE RETURNING qr_id",
    [
      1,
      "data:image/png;base64,QR({"type":"pase","pase_id":1,"expira_en":"2026-10-01T18:00:00.000Z","hash":"hmac({\\"type\\":\\"pase\\",\\"pase_id\\":1,\\"expira_en\\":\\"2026-10-01T18:00:00.000Z\\"})"})",
      2026-10-01T18:00:00.000Z,
    ],
  ],
  [
    "client",
    "COMMIT",
    [],
  ],
  [
    "client",
    "BEGIN",
    [],
  ],
  [
    "client",
    "SELECT pase_id, estado FROM pases WHERE pase_id = $1",
    [
      "1",
    ],
  ],
  [
    "client",
    "ROLLBACK",
    [],
  ],
]
`;

