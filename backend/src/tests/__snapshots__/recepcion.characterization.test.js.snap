exports[`POST /visitas pase de día → 201 con QR y audit 2`] = `
[
  [
    "client",
    "BEGIN",
    [],
  ],
  [
    "client",
    "INSERT INTO pases ( tipo_pase, socio_id, nombre_completo, identificacion, correo, telefono, mayor_16, fecha_pase, hora_entrada, estado, creado_por, observaciones ) VALUES ($1, $2, $3, $4, $5, $6, $7, CURRENT_DATE, NOW(), 'activo', $8, $9) RETURNING pase_id",
    [
      "dia",
      null,
      "Carla Ruiz",
      "INE",
      "c@x.mx",
      "4431234567",
      true,
      7,
      "nota",
    ],
  ],
  [
    "client",
    "SAVEPOINT before_qr_pase",
    [],
  ],
  [
    "client",
    "INSERT INTO codigos_qr_pases (pase_id, codigo_qr, expira_en, activo) VALUES ($1, $2, $3, TRUE) ON CONFLICT (pase_id) DO UPDATE SET codigo_qr = EXCLUDED.codigo_qr, expira_en = EXCLUDED.expira_en, activo = TRUE RETURNING qr_id",
    [
      300,
      "data:image/png;base64,QR({"type":"pase","pase_id":300,"expira_en":"2026-10-01T18:00:00.000Z","hash":"hmac({\\"type\\":\\"pase\\",\\"pase_id\\":300,\\"expira_en\\":\\"2026-10-01T18:00:00.000Z\\"})"})",
      2026-10-01T18:00:00.000Z,
    ],
  ],
  [
    "client",
    "COMMIT",
    [],
  ],
]
`;

