exports[`GET /api/reportes/socios/exportar xlsx con filtros por defecto → contenido, estilos y bytes 3`] = `
[
  [
    "pool",
    "SELECT af.codigo_accion, s.modalidad, s.tipo, s.es_titular, u.nombres, u.apellido_paterno, u.apellido_materno, u.genero, u.fecha_nacimiento, u.direccion, u.username, u.telefono, s.tel_emergencia, DATE_PART('year', AGE(CURRENT_DATE, u.fecha_nacimiento))::int AS edad FROM socios s JOIN usuarios u ON s.usuario_id = u.usuario_id LEFT JOIN acciones_familiares af ON s.accion_id = af.accion_id WHERE s.activo = TRUE ORDER BY COALESCE(NULLIF(REGEXP_REPLACE(af.codigo_accion, '\\D', '', 'g'), '')::int, s.socio_id), s.es_titular DESC",
    [],
  ],
]
`;
