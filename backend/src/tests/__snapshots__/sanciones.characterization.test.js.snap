    "pool",
    "SELECT s.sancion_id, s.socio_id, s.origen, s.motivo, s.fecha, s.estado, s.fecha_resolucion as fecha_resolucion, TRIM(CONCAT_WS(' ', u.nombres, u.apellido_paterno)) as nombre_socio, NULLIF(TRIM(CONCAT_WS(' ', r.nombres, r.apellido_paterno)), '') as nombre_resolvente, s.gravedad as gravedad, s.fecha_inicio as fecha_inicio, s.fecha_fin as fecha_fin, (LOWER(s.estado::text) IN ('activa', 'activo') AND (s.fecha_fin IS NULL OR s.fecha_fin >= CURRENT_DATE)) as activa, soc.numero_socio, soc.tipo as tipo_socio, TRIM(CONCAT_WS(' ', u.nombres, u.apellido_paterno)) as socio_nombre, u.username as socio_email FROM sanciones s JOIN socios soc ON s.socio_id = soc.socio_id JOIN usuarios u ON soc.usuario_id = u.usuario_id LEFT JOIN usuarios r ON s.resuelto_por = r.usuario_id WHERE s.socio_id = $1 ORDER BY s.fecha DESC NULLS LAST, s.fecha_inicio DESC, s.sancion_id DESC",
