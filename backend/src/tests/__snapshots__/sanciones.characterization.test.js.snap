exports[`POST /api/sanciones/no-shows/sincronizar crea una sanción por reserva no-show pendiente 1`] = `
[
  [
    "client",
    "BEGIN",
    [],
  ],
  [
    "client",
    "SELECT r.reserva_id, r.socio_id FROM reservaciones r WHERE ( COALESCE((to_jsonb(r)->>'no_show')::boolean, false) = true OR LOWER(r.estado::text) IN ('no-show', 'no show') ) AND NOT EXISTS ( SELECT 1 FROM sanciones s WHERE s.socio_id = r.socio_id AND s.origen = 'No-show reserva' AND s.motivo ILIKE ('%' || 'reserva #' || r.reserva_id || '%') )",
    [],
  ],
  [
    "client",
    "INSERT INTO sanciones (socio_id, motivo, origen, estado, gravedad, fecha_inicio, fecha_fin) VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING sancion_id",
    [
      10,
      "No-show registrado en reserva #31",
      "No-show reserva",
      "Activa",
      "Moderada",
      "2026-09-30",
      "2026-10-07",
    ],
  ],
  [
    "client",
    "INSERT INTO sanciones (socio_id, motivo, origen, estado, gravedad, fecha_inicio, fecha_fin) VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING sancion_id",
