exports[`GET /api/sanciones estado=Suspendida 1`] = `
[
  [
    "pool",
    "SELECT s.sancion_id, s.socio_id, s.origen, s.motivo, s.fecha, s.estado, NULL::date as fecha_resolucion, TRIM(CONCAT_WS(' ', u.nombres, u.apellido_paterno)) as nombre_socio, NULLIF(TRIM(CONCAT_WS(' ', r.nombres, r.apellido_paterno)), '') as nombre_resolvente, CASE WHEN s.origen ILIKE '%no-show%' THEN 'Moderada' ELSE 'Leve' END as gravedad, s.fecha::date as fecha_inicio, (s.fecha::date + ( CASE WHEN CASE WHEN s.origen ILIKE '%no-show%' THEN 'Moderada' ELSE 'Leve' END = 'Grave' THEN INTERVAL '30 days' WHEN CASE WHEN s.origen ILIKE '%no-show%' THEN 'Moderada' ELSE 'Leve' END = 'Moderada' THEN INTERVAL '7 days' ELSE INTERVAL '1 day' END ))::date as fecha_fin, (LOWER(s.estado::text) IN ('activa', 'activo') AND ((s.fecha::date + ( CASE WHEN CASE WHEN s.origen ILIKE '%no-show%' THEN 'Moderada' ELSE 'Leve' END = 'Grave' THEN INTERVAL '30 days' WHEN CASE WHEN s.origen ILIKE '%no-show%' THEN 'Moderada' ELSE 'Leve' END = 'Moderada' THEN INTERVAL '7 days' ELSE INTERVAL '1 day' END ))::date IS NULL OR (s.fecha::date + ( CASE WHEN CASE WHEN s.origen ILIKE '%no-show%' THEN 'Moderada' ELSE 'Leve' END = 'Grave' THEN INTERVAL '30 days' WHEN CASE WHEN s.origen ILIKE '%no-show%' THEN 'Moderada' ELSE 'Leve' END = 'Moderada' THEN INTERVAL '7 days' ELSE INTERVAL '1 day' END ))::date >= CURRENT_DATE)) as activa, soc.numero_socio, soc.tipo as tipo_socio, TRIM(CONCAT_WS(' ', u.nombres, u.apellido_paterno)) as socio_nombre, u.username as socio_email FROM sanciones s JOIN socios soc ON s.socio_id = soc.socio_id JOIN usuarios u ON soc.usuario_id = u.usuario_id LEFT JOIN usuarios r ON s.resuelto_por = r.usuario_id WHERE LOWER(s.estado::text) = $1 ORDER BY s.fecha::date DESC, s.sancion_id DESC LIMIT $2 OFFSET $3",
    [
      "suspendida",
      10,
      20,
    ],
  ],
  [
    "pool",
    "SELECT COUNT(*)::int as total FROM sanciones s JOIN socios soc ON s.socio_id = soc.socio_id JOIN usuarios u ON soc.usuario_id = u.usuario_id LEFT JOIN usuarios r ON s.resuelto_por = r.usuario_id WHERE LOWER(s.estado::text) = $1",
    [
      "suspendida",
    ],
  ],
]
`;

