    "pool",
    "SELECT COUNT(*) FILTER (WHERE LOWER(estado::text) IN ('activo', 'activa'))::int as total_sanciones_activas, COUNT(*)::int as total_sanciones_historico FROM sanciones WHERE socio_id = $1",
    [
      10,
    ],
  ],
  [
