        {
          "name": "GET promedio del instructor propio → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin socio_id (anónimo)', () => {",
                  "  const cuerpo = pm.response.json();",
                  "  const filas = Array.isArray(cuerpo) ? cuerpo : [cuerpo];",
                  "  filas.forEach((f) => pm.expect(f).to.not.have.property('socio_id'));",
                  "});",
                  "pm.test('Promedio de la evaluación creada', () => {",
                  "  const p = pm.response.json();",
                  "  pm.expect(p).to.have.all.keys('instructor_id', 'total', 'promedio', 'distribucion');",
                  "  pm.expect(p.total).to.eql(1);",
                  "  pm.expect(p.promedio).to.eql(5);",
