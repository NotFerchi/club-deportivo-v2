                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin socio_id (anónimo)', () => {",
                  "  const cuerpo = pm.response.json();",
                  "  const filas = Array.isArray(cuerpo) ? cuerpo : [cuerpo];",
                  "  filas.forEach((f) => pm.expect(f).to.not.have.property('socio_id'));",
                  "});",
                  "pm.test('Incluye la evaluación creada', () => {",
                  "  const ids = pm.response.json().map((e) => e.evaluacion_id);",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('evaluacionCreada')));",
                  "});"
