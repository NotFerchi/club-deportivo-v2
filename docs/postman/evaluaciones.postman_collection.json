        {
          "name": "POST caso feliz → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Sin socio_id (anónimo)', () => {",
                  "  const cuerpo = pm.response.json();",
                  "  const filas = Array.isArray(cuerpo) ? cuerpo : [cuerpo];",
                  "  filas.forEach((f) => pm.expect(f).to.not.have.property('socio_id'));",
                  "});",
                  "pm.test('Evaluación creada con el contrato', () => {",
                  "  const e = pm.response.json();",
                  "  pm.expect(e).to.have.all.keys('evaluacion_id', 'instructor_id', 'sesion_id', 'calificacion', 'comentario', 'periodo', 'fecha_creacion');",
                  "  pm.expect(e.comentario).to.eql('Muy buena clase, explica con paciencia.');",
                  "  pm.expect(e.periodo).to.eql(pm.collectionVariables.get('periodo'));",
                  "  pm.expect(String(e.instructor_id)).to.eql(String(pm.variables.get('instructorPropio')));",
                  "  pm.collectionVariables.set('evaluacionCreada', e.evaluacion_id);",
                  "});"
                ]
              }
            }
          ],
